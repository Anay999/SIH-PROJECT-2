# HEATSHIELD AI v2.0 - Backend Environment Configuration Template
# NOTE: Never commit production credentials, access tokens, or private secrets to git.

# Environment Mode: development | staging | production
APP_ENV=development
OTP_DEMO_MODE=true

# Database Connection (Default: Local SQLite)
DATABASE_URL=sqlite:///./heatshield.db

# Cryptographic Pepper Secrets (Must be changed in production)
OTP_HASH_SECRET=heatshield_dev_pepper_secret_never_use_in_prod
SESSION_SECRET=heatshield_dev_session_signing_secret_never_use_in_prod

# OTP Lifecycle and Rate Limits
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_REQUESTS_PER_HOUR=5

# WhatsApp OTP Provider: mock | meta_whatsapp | twilio
# Default is 'mock' (100% local simulation, zero external network calls)
WHATSAPP_OTP_PROVIDER=mock

# Meta WhatsApp Cloud API (Optional - Live delivery disabled by default)
META_WHATSAPP_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_TEMPLATE_NAME=heatshield_otp
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# Twilio WhatsApp API (Optional - Live delivery disabled by default)
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
