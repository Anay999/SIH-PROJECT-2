# THERMOSAFE AI v2.0 - Backend Environment Configuration Template
# NOTE: Never commit production credentials, access tokens, or private secrets to git.

# Environment Mode: development | staging | production
APP_ENV=development
OTP_DEMO_MODE=true

# Database Connection (Default: Local SQLite, PostgreSQL/PostGIS compatible)
DATABASE_URL=sqlite:///./heatshield.db

# Cryptographic Pepper Secrets (Must be changed in production)
OTP_HASH_SECRET=thermosafe_dev_pepper_secret_never_use_in_prod
SESSION_SECRET=thermosafe_dev_session_signing_secret_never_use_in_prod

# OTP Lifecycle and Rate Limits
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_REQUESTS_PER_HOUR=5

# ============================================================
# LIVE ALERT OPERATIONS: WHATSAPP CLOUD API CONFIGURATION
# ============================================================
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RATE_LIMIT_PER_SECOND=80

# Approved Meta Template Identifiers
WHATSAPP_TEMPLATE_EXTREME_HEAT=thermosafe_heat_extreme
WHATSAPP_TEMPLATE_VERY_HIGH_HEAT=thermosafe_heat_very_high
WHATSAPP_TEMPLATE_HIGH_HEAT=thermosafe_heat_high
WHATSAPP_TEMPLATE_MODERATE_HEAT=thermosafe_heat_advisory

# ============================================================
# LIVE ALERT OPERATIONS: SMS (MSG91 / DLT) CONFIGURATION
# ============================================================
SMS_ENABLED=true
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JM-GOVTSAFE
MSG91_DLT_TEMPLATE_ID=1707169482910481
MSG91_FLOW_ID=64fa829102ab3
SMS_RATE_LIMIT_PER_SECOND=100

# ============================================================
# MULTI-CHANNEL DISPATCH & RESILIENCE STRATEGY
# ============================================================
# NOTIFICATION_DELIVERY_MODE: PARALLEL (simultaneous) | FAILOVER (WhatsApp then SMS fallback)
NOTIFICATION_DELIVERY_MODE=PARALLEL
ENABLE_CHANNEL_FALLBACK=true

# Deduplication Window: suppress exact duplicate alerts sent within N minutes
ALERT_DEDUP_WINDOW_MINUTES=60

# Retry Policy (Exponential Backoff with Jitter)
NOTIFICATION_MAX_RETRIES=4
NOTIFICATION_BACKOFF_SECONDS=10
