# HEATSHIELD AI v2.0 - Frontend Environment Configuration Template
# NOTE: Only public, browser-restricted client tokens may be placed here.
# Never place backend secrets, WhatsApp tokens, or database passwords in this file.

# Map Provider Selection: carto_dark | maptiler | mapbox | osm_demo | custom
VITE_MAP_PROVIDER=carto_dark

# Public browser tokens (Domain/referrer-restricted on provider dashboards)
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# Optional Custom Tile/Style endpoints
VITE_MAP_TILE_URL=
VITE_MAP_STYLE_URL=
VITE_MAP_ATTRIBUTION=

# Backend API endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000
